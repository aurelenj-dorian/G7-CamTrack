digraph G { rankdir=LR; fontname="DejaVu Sans"; labelloc=t; fontsize=22; nodesep=0.5; ranksep=0.35; newrank=true;
label=<<b>CamTrack — Pipeline de livraison cible</b><br/><font point-size="13">Schéma de conception (aucun outil nommé). Les badges [Gx] renvoient aux goulots de goulots.docx.</font><br/> >;
node [shape=plaintext, fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans", fontsize=11];
dev [label=<<table border="1" cellborder="0" cellpadding="6" style="rounded" bgcolor="white"><tr><td><b>DÉVELOPPEUR</b></td></tr><tr><td>commit + push<br/>petits changements,<br/>plusieurs fois par jour</td></tr></table>>];
repo [label=<<table border="2" color="#1F5FA8" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E8F1FB"><tr><td><b>1. DÉPÔT DE CODE</b></td></tr><tr><td><font point-size="10">Source unique versionnée,<br/>revue de code obligatoire</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G6] [G8]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Conflit, revue refusée</font></td></tr></table>>];
build [label=<<table border="2" color="#1F5FA8" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E8F1FB"><tr><td><b>2. BUILD</b></td></tr><tr><td><font point-size="10">Reproductible,<br/>dépendances figées</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G7]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Erreur de compilation,<br/>dépendance manquante</font></td></tr></table>>];
tests [label=<<table border="2" color="#1F5FA8" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E8F1FB"><tr><td><b>3. TESTS AUTO</b></td></tr><tr><td><font point-size="10">Unitaires + intégration<br/>à chaque push</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G2]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Un test échoue,<br/>couverture &lt; seuil</font></td></tr></table>>];
sec [label=<<table border="2" color="#1F5FA8" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E8F1FB"><tr><td><b>4. ANALYSE SÉCURITÉ</b></td></tr><tr><td><font point-size="10">Dépendances, secrets<br/>dans le code, image</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G10]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Faille critique,<br/>secret détecté</font></td></tr></table>>];
img [label=<<table border="2" color="#1F5FA8" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E8F1FB"><tr><td><b>5. IMAGE</b></td></tr><tr><td><font point-size="10">Artefact unique, immuable,<br/>tagué n° de commit,<br/>conservé au registre</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G1] [G7]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Construction ou<br/>publication échoue</font></td></tr></table>>];
rec [label=<<table border="2" color="#2CA02C" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E9F7E9"><tr><td><b>6. RECETTE (env. 1)</b></td></tr><tr><td><font point-size="10">Copie de la prod, même image,<br/>config par environnement,<br/>tests de fumée + acceptation</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G9] [G5]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Déploiement ou tests KO<br/>→ recette remise en N-1</font></td></tr></table>>];
app [label=<<table border="2" color="#B8860B" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#FFF2CC"><tr><td><b>7. APPROBATION HUMAINE</b></td></tr><tr><td><font point-size="10">Un humain valide ici<br/>(produit / exploitation),<br/>à tout moment de la semaine</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G4] [G8]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Refus motivé<br/>(commentaire)</font></td></tr></table>>];
prod [label=<<table border="2" color="#2CA02C" cellborder="0" cellspacing="0" cellpadding="5" style="rounded" bgcolor="#E9F7E9"><tr><td><b>8. PRODUCTION (env. 2)</b></td></tr><tr><td><font point-size="10">Déploiement auto sans coupure,<br/>nouvelle version démarrée<br/>avant d'arrêter l'ancienne</font></td></tr><tr><td><font color="#7B3FA0" point-size="11"><b>[G3] [G1]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Échoue si :</b><br/>Vérif. de santé KO<br/>→ RETOUR AUTO à N-1</font></td></tr></table>>];
mon [label=<<table border="2" color="#7B3FA0" cellborder="0" cellpadding="5" style="rounded" bgcolor="#F3E8FB"><tr><td><b>9. SUPERVISION</b></td></tr><tr><td><font point-size="10">Disponibilité, erreurs,<br/>temps de réponse,<br/>nombre de commandes<br/>→ alertes à l'équipe</font></td></tr><tr><td><font color="#7B3FA0"><b>[G5]</b></font></td></tr><tr><td bgcolor="#FDECEC"><font color="#D62728" point-size="10"><b>Alerte grave :</b><br/>retour à N-1 + équipe prévenue</font></td></tr></table>>];
subgraph cluster_ci { label="INTÉGRATION CONTINUE — automatique à chaque push"; style="rounded,dashed"; color="#1F5FA8"; fontcolor="#1F5FA8"; fontsize=13; repo; build; tests; sec; img; }
subgraph cluster_cd { label="LIVRAISON CONTINUE — deux environnements"; style="rounded,dashed"; color="#2CA02C"; fontcolor="#2CA02C"; fontsize=13; rec; app; prod; }
dev -> repo -> build -> tests -> sec -> img -> rec -> app -> prod -> mon [penwidth=2.5];
rule [label=<<table border="2" color="#D62728" cellborder="0" cellpadding="8" bgcolor="#FDECEC"><tr><td><font color="#D62728"><b>RÈGLE COMMUNE À TOUTE ÉTAPE EN ÉCHEC</b><br/>le pipeline s'arrête, le changement est REFUSÉ<br/>(rien ne passe à l'étape suivante),<br/>l'auteur est PRÉVENU avec le journal de l'erreur</font></td></tr></table>>];
loop [label=<<table border="2" color="#7B3FA0" cellborder="0" cellpadding="8" bgcolor="#F3E8FB"><tr><td><font color="#7B3FA0"><b>BOUCLE DE RETOUR</b><br/>notifications d'échec du pipeline + alertes de supervision<br/>+ tableau de bord → l'équipe sait en minutes qu'un déploiement<br/>s'est mal passé → correctif = nouveau commit (même chemin)</font></td></tr></table>>];
{rank=same; rule; tests;} {rank=same; loop; app;}
rule -> dev [style=dashed, color="#D62728", fontcolor="#D62728", label="notification"];
mon -> loop [style=dashed, color="#7B3FA0", penwidth=2];
loop -> dev [style=dashed, color="#7B3FA0", penwidth=2, label="apprentissage", fontcolor="#7B3FA0"];
}